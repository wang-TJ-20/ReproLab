# --- Upstream paper code (pulled at install time; submodules tracked via .gitmodules) ---
third_party/*
!third_party/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.uv/
*.egg-info/

# --- Secrets / local env ---
.env
*.local

